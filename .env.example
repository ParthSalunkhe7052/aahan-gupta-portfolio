# Port for the API / production server
PORT=8787

# Interface to listen on. Default 127.0.0.1 (this machine only), which is right for
# local development and for a reverse proxy on the same machine. Use 0.0.0.0 only when
# the platform's own router is the way in (Render, Railway, Fly.io).
# HOST=127.0.0.1

# Set to 1 when a reverse proxy sits in front (nginx, Caddy, a platform router): the
# server then trusts X-Forwarded-For/-Proto/-Host. Without it every visitor looks like
# the proxy, so the sign-in limiter is shared by everyone. Keep the Node port reachable
# only through the proxy when this is on. See README, Hosting.
TRUST_PROXY=

# First-run admin password. Used only when storage/auth.json does not exist yet;
# after that, change it from the admin panel (Security tab).
# If left empty, a random password is generated and printed once in the server log.
ADMIN_PASSWORD=

# Session cookie "Secure" flag. Leave empty: in production it is on automatically for
# every host except localhost, and whenever the request is HTTPS.
#   1  always Secure
#   0  never force it (plain-HTTP staging or LAN use only; do not use on the public site)
COOKIE_SECURE=
