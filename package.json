{
  "name": "aahan-gupta-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,red \"vite\" \"tsx watch --clear-screen=false --env-file-if-exists=.env server/index.ts --port 8787\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false --env-file-if-exists=.env server/index.ts --port 8787",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "media": "tsx scripts/build-media.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/build-seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.27",
    "multer": "^2.4.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
